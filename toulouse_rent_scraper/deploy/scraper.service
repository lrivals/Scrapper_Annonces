# Service systemd utilisateur — scraping planifié (déclenché par scraper.timer)
# Installation : voir README.md, section « Automatisation ».
# Chemins : à adapter si le projet n'est pas dans ~/Documents/Perso/Scrapper_Annonces.

[Unit]
Description=Scrapper Annonces — scraping planifié (tous les profils)
After=graphical-session.target network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/Perso/Scrapper_Annonces/toulouse_rent_scraper
ExecStart=%h/Documents/Perso/Scrapper_Annonces/venv/bin/python main.py scrape --enrich --limit 20 --unattended
# Chrome n'est pas headless (DataDome) : il a besoin de la session graphique.
# DISPLAY / XAUTHORITY / WAYLAND_DISPLAY viennent de l'environnement systemd utilisateur
# (vérifier : systemctl --user show-environment | grep DISPLAY).
# 75 = un autre run tient déjà le verrou (bouton de l'UI) : pas une panne.
SuccessExitStatus=75
TimeoutStartSec=2h
Nice=10
