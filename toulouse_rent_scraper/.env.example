# Copier en .env (ignoré par git) et compléter.
# Les variables déjà définies dans l'environnement sont prioritaires.

# --- Notifications : "ntfy" (recommandé) ou "telegram" ; vide = désactivé ---
NOTIFY_BACKEND=ntfy

# ntfy.sh : installer l'appli ntfy et s'abonner au topic.
# Le topic fait office de mot de passe : le choisir long et aléatoire, par exemple
#   python -c "import secrets; print('annonces-' + secrets.token_urlsafe(18))"
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=            # seulement pour un serveur ntfy protégé

# Telegram (si NOTIFY_BACKEND=telegram) : bot créé via @BotFather
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Interface web ---
# UI_SECRET_KEY=         # clé de session fixe (sinon régénérée à chaque démarrage)
