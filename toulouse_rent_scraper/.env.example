# Copier en .env (ignoré par git) et compléter.
# Les variables déjà définies dans l'environnement sont prioritaires.

# --- Notifications : "ntfy" (recommandé) ou "telegram" ; vide = désactivé ---
NOTIFY_BACKEND=ntfy

# ntfy.sh : installer l'appli ntfy et s'abonner au topic.
# Le topic fait office de mot de passe : le choisir long et aléatoire, par exemple
#   python -c "import secrets; print('annonces-' + secrets.token_urlsafe(18))"
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=            # seulement pour un serveur ntfy protégé

# Telegram (si NOTIFY_BACKEND=telegram) : bot créé via @BotFather
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Top 10 par profil après un run (Sprint 5.6) : off (défaut), daily (une fois par jour), run (chaque run)
# NOTIFY_TOP10=daily

# --- Interface web ---
# UI_SECRET_KEY=         # clé de session fixe (sinon régénérée à chaque démarrage)
# API_TOKEN=             # jeton de l'API /api/v1 hors de la machine (Docker, réseau) ; vide = local seulement
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Analyse des descriptions par LLM (Sprint 15.4) — désactivée par défaut ---
# Plus simple : page « Connexion LLM » de l'interface (prioritaire sur ces variables).
# Chacun utilise SON fournisseur et SA clé ; aucune autre clé de la machine n'est lue.
# LLM_PROVIDER=anthropic         # anthropic, openai, mistral, openrouter, groq, ollama, lmstudio, openai_compatible
# LLM_MODEL=                     # vide = claude-opus-5-5 pour anthropic ; obligatoire pour les autres
# LLM_API_KEY=                   # inutile pour ollama / lmstudio (local)
# LLM_BASE_URL=                  # seulement pour openai_compatible (ou pour changer l'URL par défaut)
# LLM_ANALYSIS=1                 # analyse automatique après chaque scraping / enrichissement
